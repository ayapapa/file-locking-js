{
  "name": "@ayapapa-npm/file-locking-js",
  "version": "0.1.0",
  "description": "File-based mutual exclusion using mutex files for cross-process locking",
  "license": "MIT",
  "author": "ayapapa",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --out-dir dist --clean --dts",
    "build:doc": "npx typedoc && node scripts/rename-docs.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:debug": "vitest --inspect-brk --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest run --coverage && start coverage/index.html",
    "check": "npm run typecheck && npm run build && npm run build:doc && npm run coverage",
    "check:ui": "npm run typecheck && npm run build && npm run build:doc && npm run coverage:ui",
    "release:check": "npm run check",
    "prepublishOnly": "npm run release:check"
  },
  "devDependencies": {
    "@ayapapa-npm/pretty-console-js": "^0.2.2",
    "@types/node": "^26.2.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "pino": "^10.3.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@ayapapa-npm/contracts-js": "^0.4.3",
    "@ayapapa-npm/date-formatter-js": "^0.1.2",
    "lru-cache": "^11.5.2",
    "signal-exit": "^4.1.0"
  }
}
