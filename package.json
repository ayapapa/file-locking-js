{
  "name": "@ayapapa-npm/file-locking-js",
  "version": "0.1.0-alpha.01",
  "keywords": [
    "node",
    "javascript",
    "typescript",
    "sdk",
    "api", 
    "utility",
    "key-based lock",
    "file-based lock",
    "inter-process lock",
    "deadlock detection"
  ],
  "description": "File-based mutual exclusion using mutex files for cross-process locking",
  "license": "MIT",
  "author": "ayapapa",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --out-dir dist --clean --dts",
    "build:doc": "npx typedoc && node scripts/rename-docs.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:pretty": "npm run test && npm run prettyLog",
    "test:debug": "vitest --inspect-brk --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prettyLog": "powershell -Command \"Get-Content ./logs/file-lock.log | npx pino-pretty --translateTime 'SYS:standard'  --ignore 'pid,hostname' | Set-Content ./logs/pretty.log -Encoding utf8\"",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest run --coverage && start coverage/index.html",
    "check": "npm run typecheck && npm run lint && npm run build && npm run build:doc && npm run coverage",
    "check:ui": "npm run typecheck && npm run lint && npm run build && npm run build:doc && npm run coverage:ui",
    "release:check": "npm run check",
    "prepublishOnly": "npm run release:check",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@ayapapa-npm/pretty-console-js": "^0.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.11.0",
    "pino": "^10.3.1",
    "rotating-file-stream": "^3.2.10",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@ayapapa-npm/contracts-js": "^0.6.0",
    "@ayapapa-npm/date-formatter-js": "^0.1.2",
    "lru-cache": "^11.5.2",
    "signal-exit": "^4.1.0"
  }
}
